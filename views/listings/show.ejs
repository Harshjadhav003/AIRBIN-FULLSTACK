
<% layout("/layouts/boilerplate") %>

<div class="container mt-4 text-center">

  <!-- Title -->
  <h3 class="mb-3"><%= listing.title %></h3>

  <!-- 🖼️ Image Section -->
  <div class="image-container mx-auto" style="max-width: 600px;">
    <% for (let image of listing.image) { %>
      <img 
        src="<%= image.url %>" 
        alt="listing_image" 
        class="img-fluid rounded shadow-sm mb-3" 
        style="width: 100%; height: 350px; object-fit: cover;"
      >
    <% } %>
  </div>

  <!-- 📝 Info Section -->
  <div class="info-container mx-auto mt-3 p-3 rounded shadow-sm" style="max-width: 600px; background-color: #f8f9fa;">
    <p class="mb-2"><%= listing.description %></p>
    <p class="mb-1 fw-bold">₹<%= listing.price.toLocaleString("en-IN") %></p>
    <p class="mb-1"><%= listing.location %></p>
    <p class="mb-0"><%= listing.country %></p>
  </div>

  <!-- ✏️ Edit + Delete Buttons -->
  <div class="mt-3">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-2">Edit</a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
      <button class="btn btn-dark">Delete</button>
    </form>
  </div>

  <hr class="mt-4">

  <!-- 💬 Review Form -->
  <div class="mx-auto" style="max-width: 600px;">
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mt-3">
      <div class="mb-3">
        <label for="rating" class="form-label">Rating</label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" required>
      </div>

      <div class="mb-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" rows="5" class="form-control text-center" required></textarea>
        <div class="invalid-feedback">Please add a comment for your review.</div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>
  </div>

  <hr class="mt-4">

  <!-- ⭐ All Reviews -->
  <div class="mx-auto" style="max-width: 700px;">
    <h4>All Reviews</h4>

    <div class="row justify-content-center mt-3">
      <% if (listing.reviews.length === 0) { %>
        <p>No reviews yet. Be the first to review!</p>
      <% } %>

      <% for (let review of listing.reviews) { %>
        <div class="card col-md-5 m-2 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Harsh Jadhav</h5>
            <p class="card-text"><%= review.comment %></p>
            <p class="card-text"><%= review.rating %> ⭐</p>
          </div>
          <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">
            <button class="btn btn-dark btn-sm">Delete</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

</div>
