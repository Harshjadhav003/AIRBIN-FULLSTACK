<% layout("/layouts/boilerplate") %>
<%= success %>

<style>
/* ===== FILTER BAR ===== */
#filters {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    white-space: nowrap;
    padding: 0.8rem 1rem;
    gap: 1rem;
    scrollbar-width: none; /* Firefox */
    border-bottom: 1px solid #e6e6e6;
    margin-bottom: 1rem;
    background-color: #fff;
}
#filters::-webkit-scrollbar { display: none; }

.filter {
    text-align: center;
    min-width: 70px;
    padding: 0.5rem;
    flex-shrink: 0;
    border-radius: 12px;
    transition: all 0.2s ease-in-out;
    opacity: 0.7;
    background-color: #fff;
}
.filter.active, .filter:hover {
    background-color: #f5f5f5;
    opacity: 1;
    cursor: pointer;
    transform: scale(1.05);
}
.filter a { color: black; text-decoration: none; }
.filter p { font-size: 0.8rem; margin: 0.25rem 0 0; }

/* ===== TAX TOGGLE ===== */
.tax-toggle {
    border: 1px solid #ccc;
    border-radius: 1rem;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    margin-left: auto;
    font-size: 0.9rem;
    background-color: #fff;
}
.tax-toggle input { margin-right: 0.5rem; }

/* ===== LISTING CARDS ===== */
.listing-link { text-decoration: none; color: inherit; }
.listing-card {
    margin-bottom: 1.5rem;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    background-color: #fff;
}
.listing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}
.listing-card img {
    width: 100%;
    height: 20rem;
    object-fit: cover;
}
.card-body {
    padding: 0.75rem 1rem;
}
.card-text b {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1rem;
}
.card-text .tax-info { display: none; font-size: 0.8rem; color: #555; }

/* ===== PAGINATION ===== */
.pagination {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0;
}
.pagination a {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: #f5f5f5;
    text-decoration: none;
    color: #333;
    transition: background 0.2s;
}
.pagination a:hover { background: #e6e6e6; }

/* ===== RESPONSIVE ===== */
@media (max-width: 992px) {
    .row-cols-lg-3 { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 768px) {
    #filters { padding: 0.5rem; gap: 0.5rem; }
    .filter { min-width: 60px; }
    .tax-toggle { font-size: 0.8rem; padding: 0.4rem 0.8rem; }
    .row-cols-md-2 { grid-template-columns: repeat(1, 1fr) !important; }
}
</style>

<div id="filters">
    <div class="filter <%= category === 'Trending' ? 'active' : '' %>">
        <a href="/listings?category=Trending">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>
    </div>
    <div class="filter <%= category === 'Rooms' ? 'active' : '' %>">
        <a href="/listings?category=Rooms">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>
    </div>
    <div class="filter <%= category === 'Iconic Cities' ? 'active' : '' %>">
        <a href="/listings?category=Iconic%20Cities">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </a>
    </div>
    <div class="filter <%= category === 'Mountains' ? 'active' : '' %>">
        <a href="/listings?category=Mountains">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </a>
    </div>
    <div class="filter <%= category === 'Castles' ? 'active' : '' %>">
        <a href="/listings?category=Castles">
            <div><i class="fa-solid fa-chess-rook"></i></div>
            <p>Castles</p>
        </a>
    </div>
    <div class="filter <%= category === 'Amazing pools' ? 'active' : '' %>">
        <a href="/listings?category=Amazing%20pools">
            <div><i class="fa-duotone fa-solid fa-person-swimming"></i></div>
            <p>Amazing pools</p>
        </a>
    </div>
    <div class="filter <%= category === 'Camping' ? 'active' : '' %>">
        <a href="/listings?category=Camping">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>
    </div>
    <div class="filter <%= category === 'Farms' ? 'active' : '' %>">
        <a href="/listings?category=Farms">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </a>
    </div>
    <div class="filter <%= category === 'Arctic' ? 'active' : '' %>">
        <a href="/listings?category=Arctic">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </a>
    </div>
    <div class="filter <%= category === 'Domes' ? 'active' : '' %>">
        <a href="/listings?category=Domes">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </a>
    </div>
    <div class="filter <%= category === 'Boats' ? 'active' : '' %>">
        <a href="/listings?category=Boats">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </a>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 mt-3">
    <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link col">
            <div class="card listing-card">
                <img 
                  src="<%= listing.image ? listing.image.url : '/images/default.jpg' %>" 
                  class="card-img-top"
                  alt="listing_image"
                >
                <div class="card-body">
                    <p class="card-text">
                       <b><%= listing.title %></b><br>
                       &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                       <i class="tax-info"> +18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>

<div class="pagination">
    <% if (currentPage > 1) { %>
        <a href="/listings?page=<%= currentPage - 1 %>&category=<%= category || '' %>">Previous</a>
    <% } %>
    <% if (currentPage < totalPages) { %>
        <a href="/listings?page=<%= currentPage + 1 %>&category=<%= category || '' %>">Next</a>
    <% } %>
</div>

<script>
let taxSwitch = document.getElementById("switchCheckDefault");
taxSwitch.addEventListener("click", () => {
    let taxinfo = document.querySelectorAll(".tax-info");
    taxinfo.forEach(info => {
        info.style.display = (info.style.display === "inline") ? "none" : "inline";
    });
});
</script>
